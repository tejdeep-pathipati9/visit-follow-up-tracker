# Copy to .env for local use. Uvicorn reads it with --env-file .env.
FOLLOWUP_DB_PATH=./data/followups.db

# Optional; only /api/ask needs these. UI searches work without a model API key.
OPENAI_API_KEY=
# Models this key can use, comma separated; the first writes SQL. Prompt checks
# always use the Decisions API model gpt-6-luna.
OPENAI_MODELS=
# OPENAI_SQL_MODEL=
